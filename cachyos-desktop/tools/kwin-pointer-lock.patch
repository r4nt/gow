+void TestPointerConstraints::testLockedPointerStateChangedSignal()
+{
+    // Verify that PointerInputRedirection::pointerLockStateChanged fires when a
+    // client acquires and releases a pointer lock.
+    std::unique_ptr<KWayland::Client::Surface> surface(Test::createSurface());
+    std::unique_ptr<Test::XdgToplevel> shellSurface(Test::createXdgToplevelSurface(surface.get()));
+    std::unique_ptr<KWayland::Client::Pointer> pointer(Test::waylandSeat()->createPointer());
+    std::unique_ptr<KWayland::Client::LockedPointer> lockedPointer(
+        Test::waylandPointerConstraints()->lockPointer(surface.get(), pointer.get(), nullptr,
+                                                       KWayland::Client::PointerConstraints::LifeTime::OneShot));
+
+    auto window = Test::renderAndWaitForShown(surface.get(), QSize(100, 100), Qt::blue);
+    QVERIFY(window);
+
+    QSignalSpy lockStateSpy(input()->pointer(), &PointerInputRedirection::pointerLockStateChanged);
+
+    // Warp pointer into window to trigger lock. The signal fires synchronously.
+    KWin::input()->pointer()->warp(window->frameGeometry().center());
+    QCOMPARE(input()->pointer()->isConstrained(), true);
+    if (lockStateSpy.isEmpty()) {
+        QVERIFY(lockStateSpy.wait());
+    }
+    QCOMPARE(lockStateSpy.count(), 1);
+    QCOMPARE(lockStateSpy.first().first().toBool(), true);
+
+    // Deactivating the window should unlock and fire the signal again.
+    workspace()->activateWindow(nullptr);
+    QCOMPARE(input()->pointer()->isConstrained(), false);
+    if (lockStateSpy.count() < 2) {
+        QVERIFY(lockStateSpy.wait());
+    }
+    QCOMPARE(lockStateSpy.last().first().toBool(), false);
+}
+
+void TestPointerConstraints::testLockedPointerRelativeMotion()
+{
+    // Verify that relative motion events are forwarded to clients while the pointer is locked,
+    // and that the absolute cursor position does not change.
+    std::unique_ptr<KWayland::Client::Surface> surface(Test::createSurface());
+    std::unique_ptr<Test::XdgToplevel> shellSurface(Test::createXdgToplevelSurface(surface.get()));
+    std::unique_ptr<KWayland::Client::Pointer> pointer(Test::waylandSeat()->createPointer());
+    std::unique_ptr<KWayland::Client::LockedPointer> lockedPointer(
+        Test::waylandPointerConstraints()->lockPointer(surface.get(), pointer.get(), nullptr,
+                                                       KWayland::Client::PointerConstraints::LifeTime::Persistent));
+    std::unique_ptr<KWayland::Client::RelativePointer> relativePointer(
+        Test::waylandRelativePointerManager()->createRelativePointer(pointer.get()));
+
+    QSignalSpy lockedSpy(lockedPointer.get(), &KWayland::Client::LockedPointer::locked);
+    QSignalSpy relativeMotionSpy(relativePointer.get(), &KWayland::Client::RelativePointer::relativeMotion);
+
+    auto window = Test::renderAndWaitForShown(surface.get(), QSize(100, 100), Qt::blue);
+    QVERIFY(window);
+
+    // Acquire the lock.
+    KWin::input()->pointer()->warp(window->frameGeometry().center());
+    QCOMPARE(input()->pointer()->isConstrained(), true);
+    QVERIFY(lockedSpy.wait());
+
+    const QPointF lockedPos = KWin::Cursors::self()->mouse()->pos();
+
+    // Inject relative motion while locked and verify it is forwarded.
+    quint32 timestamp = 1;
+    Test::pointerMotionRelative(QPointF(10, 5), timestamp++);
+    QVERIFY(relativeMotionSpy.wait());
+    // At least one relativeMotion event must carry the injected delta.
+    const auto hasDelta10_5 = [&]() {
+        for (const auto &call : relativeMotionSpy) {
+            if (call.first().toSizeF() == QSizeF(10, 5)) {
+                return true;
+            }
+        }
+        return false;
+    };
+    QVERIFY(hasDelta10_5());
+
+    // The absolute cursor position must not change while locked.
+    QCOMPARE(KWin::Cursors::self()->mouse()->pos(), lockedPos);
+
+    // A second relative motion event is also forwarded.
+    relativeMotionSpy.clear();
+    Test::pointerMotionRelative(QPointF(-3, 7), timestamp++);
+    QVERIFY(relativeMotionSpy.wait());
+    const auto hasDeltaMinus3_7 = [&]() {
+        for (const auto &call : relativeMotionSpy) {
+            if (call.first().toSizeF() == QSizeF(-3, 7)) {
+                return true;
+            }
+        }
+        return false;
+    };
+    QVERIFY(hasDeltaMinus3_7());
+    QCOMPARE(KWin::Cursors::self()->mouse()->pos(), lockedPos);
+}
