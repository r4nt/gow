+void WaylandBackend::connectPointerLock()
+{
+    connect(input()->pointer(), &PointerInputRedirection::pointerLockStateChanged,
+            this, &WaylandBackend::updatePointerLock);
+}
+
+void WaylandBackend::updatePointerLock(bool locked)
+{
+    if (locked != m_pointerLockRequested) {
+        if (locked) {
+            m_seat->createRelativePointer();
+        }
+        togglePointerLock();
+        if (!locked) {
+            m_seat->destroyRelativePointer();
+        }
+    }
+}
